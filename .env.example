# Copy this file to .env and fill in real values. NEVER commit the real .env file.

# App
APP_SECRET_KEY=generate-a-long-random-string-here
DATABASE_URL=postgresql+psycopg2://phishapp:changeme@localhost:5432/phishdb
POSTGRES_PASSWORD=changeme

# Active Directory
AD_SERVER=ldap://192.168.56.10
AD_DOMAIN=corp.local
AD_BASE_DN=DC=corp,DC=local

# Optional: restrict login to members of this AD group. Leave blank to allow any valid AD user.
AD_REQUIRED_GROUP=PhishAnalyzer-Users

# Optional: read-only service account used to check group membership.
# If left blank, group membership checking is skipped (any authenticated AD user gets in).
AD_SERVICE_USER=svc-phishapp@corp.local
AD_SERVICE_PASS=service-account-password
